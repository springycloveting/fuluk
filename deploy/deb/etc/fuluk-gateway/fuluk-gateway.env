# Fuluk Gateway production configuration.
# This file is a dpkg conffile; edits are preserved across upgrades.

HOST=127.0.0.1
PORT=8787

# REQUIRED: Authentication token for API access.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will NOT start without this value.
SESSION_GATEWAY_TOKEN=

# Allow arbitrary shell command execution in "runtime" sessions.
# Only enable if you trust all authenticated users.
SESSION_GATEWAY_ALLOW_RUNTIME=false

# Persistent state directory.
SESSION_GATEWAY_DB=/var/lib/fuluk-gateway/session-gateway.sqlite
SESSION_GATEWAY_SETTINGS=/var/lib/fuluk-gateway/session-gateway-settings.json

# Runtime shell used by "runtime" sessions.
SESSION_GATEWAY_RUNTIME=/bin/bash

# tmux submit behavior.
SESSION_GATEWAY_CODEX_SUBMIT_KEY=Enter
SESSION_GATEWAY_CLAUDE_SUBMIT_KEY=Enter
SESSION_GATEWAY_OPENCODE_SUBMIT_KEY=Enter
SESSION_GATEWAY_RUNTIME_SUBMIT_KEY=Enter
SESSION_GATEWAY_SUBMIT_KEY_DELAY_MS=80
